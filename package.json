  "description": "Zotero 8–10 plugin: citation counts from OpenAlex and Semantic Scholar as sortable columns.",
  "private": true,
  "license": "MIT",
  "author": "Huifa Li",
  "config": {
    "repo": "LFD-byte/zotero-citetally",
    "addonID": "citetally@lfd-byte.github.io",
